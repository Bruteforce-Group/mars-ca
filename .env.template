# UniFi Controller Authentication Configuration
# Copy this file to .env and fill in your credentials

# Controller connection details
UNIFI_CONTROLLER_HOSTNAME_MARS=mars.int.bozza.au
UNIFI_USERNAME_MARS=root

# Authentication - provide EITHER password OR API key
# Option 1: Username/Password authentication
UNIFI_PASSWORD_MARS=your_password_here

# Option 2: API Key authentication (recommended for automation)
UNIFI_API_KEY_MARS=your_api_key_here

# Notes:
# - API key authentication is more secure for automation
# - You can generate an API key in UniFi Network Controller under Settings > Admins
# - If both password and API key are provided, API key will be tried first